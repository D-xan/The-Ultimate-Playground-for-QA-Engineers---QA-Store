# Public URL the site is served from. The only place the domain is written down:
# build base path, index.html meta tags, solution snippets and the certificate all read it.
VITE_SITE_URL=https://qa.randomly.online/
# Optional: the URL this particular build is served from, when it differs (the GitHub Pages mirror).
# CI sets it; leave it unset locally.
# VITE_PUBLIC_URL=
